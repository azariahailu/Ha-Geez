# Production database (Turso / libSQL). Leave unset for a local SQLite file
# at data/ha-geez.db — no Docker required.
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=

# LIBSQL_URL and LIBSQL_AUTH_TOKEN are accepted as aliases.
# A postgres:// DATABASE_URL is not used. Unset it locally if you have one.

# The admin password is created in the browser at /admin the first time
# that page is opened. It is stored as a hash in the database. There is
# no default password, and an environment variable does not set it.

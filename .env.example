# Password for /admin. Required in production.
# Local `npm run dev` uses dev-ha-geez when this is unset.
ADMIN_PASSWORD=

# Optional. Defaults to ADMIN_PASSWORD. Changing it signs every editor out.
# ADMIN_SESSION_SECRET=

# Production database (Turso / libSQL). Leave unset for a local SQLite file
# at data/ha-geez.db — no Docker required.
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=

# LIBSQL_URL and LIBSQL_AUTH_TOKEN are accepted as aliases.
# A postgres:// DATABASE_URL is not used. Unset it locally if you have one.
